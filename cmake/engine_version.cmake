# Generates a version source file from git state. Runs in script mode at build
# time so the hash and dirty flag never go stale between configures.
#
# For the sake of transparency, this file was generated by an LLM.
# I hate working with Git integration in CMake and I think that
# this is one of the most annoying things ever. I just want to get
# this working asap.
#
# Usage:
#   cmake -DSOURCE_DIR=<repo> -DINPUT=<file.in> -DOUTPUT=<file>
#         -DVERSION_MAJOR=<n> -DVERSION_MINOR=<n> -DVERSION_PATCH=<n>
#         -P engine_version.cmake

set(GIT_HASH "unknown")
set(GIT_DIRTY false)
set(GIT_TAGGED false)

set(VERSION_CORE "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}")

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE git_hash
        RESULT_VARIABLE git_result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_VARIABLE git_error
        ERROR_STRIP_TRAILING_WHITESPACE
    )

    # Surface the reason instead of silently falling back to "unknown"
    if(NOT git_result EQUAL 0)
        message(WARNING "engine_version: 'git rev-parse' failed, using hash 'unknown':\n${git_error}")
    endif()

    if(git_result EQUAL 0)
        set(GIT_HASH ${git_hash})

        # Untracked files are ignored, matching 'git describe --dirty'
        execute_process(
            COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
            WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE git_status
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )

        if(NOT git_status STREQUAL "")
            set(GIT_DIRTY true)
        endif()

        # A release is HEAD carrying the tag for this exact version ('vX.Y.Z'
        # or 'X.Y.Z'); unrelated tags on the same commit don't count
        execute_process(
            COMMAND ${GIT_EXECUTABLE} tag --points-at HEAD
            WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE git_tags
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        string(REPLACE "\n" ";" git_tags "${git_tags}")

        if("v${VERSION_CORE}" IN_LIST git_tags OR "${VERSION_CORE}" IN_LIST git_tags)
            set(GIT_TAGGED true)
        endif()
    endif()
endif()

# Clean tagged releases get the bare version. Everything else carries the hash
# as semver build metadata after '+' ('-' would mark a pre-release).
set(VERSION_SEMVER "${VERSION_CORE}")
if(NOT GIT_TAGGED OR GIT_DIRTY)
    string(APPEND VERSION_SEMVER "+${GIT_HASH}")
    if(GIT_DIRTY)
        string(APPEND VERSION_SEMVER ".dirty")
    endif()
endif()

# Only touches OUTPUT when the content changes, so no needless rebuilds
configure_file(${INPUT} ${OUTPUT} @ONLY)
