{
    "version": 7,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_COLOR_DIAGNOSTICS": true
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "platform-sdl3",
            "hidden": true,
            "inherits": [
                "default"
            ],
            "cacheVariables": {
                "TARGET_PLATFORM": "sdl3"
            }
        },
        {
            "name": "platform-psp",
            "hidden": true,
            "inherits": [
                "default"
            ],
            "condition": {
                "type": "notEquals",
                "lhs": "$penv{PSPDEV}",
                "rhs": ""
            },
            "toolchainFile": "$penv{PSPDEV}/psp/share/pspdev.cmake",
            "cacheVariables": {
                "TARGET_PLATFORM": "psp",
                "BUILD_TESTS": false
            }
        },
        {
            "name": "sdl3-debug",
            "inherits": [
                "platform-sdl3",
                "debug"
            ]
        },
        {
            "name": "sdl3-release",
            "inherits": [
                "platform-sdl3",
                "release"
            ]
        },
        {
            "name": "psp-debug",
            "inherits": [
                "platform-psp",
                "debug"
            ]
        },
        {
            "name": "psp-release",
            "inherits": [
                "platform-psp",
                "release"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "sdl3-debug",
            "configurePreset": "sdl3-debug"
        },
        {
            "name": "sdl3-release",
            "configurePreset": "sdl3-release"
        },
        {
            "name": "psp-debug",
            "configurePreset": "psp-debug"
        },
        {
            "name": "psp-release",
            "configurePreset": "psp-release"
        }
    ]
}
